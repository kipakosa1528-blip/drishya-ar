{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["external/**", "css/**", "js/**", "*.html", "uploads/.gitkeep"]
      }
    }
  ],
  "routes": [
    { "src": "/external/(.*)", "dest": "/external/$1" },
    { "src": "/css/(.*)",      "dest": "/css/$1" },
    { "src": "/js/(.*)",       "dest": "/js/$1" },
    { "src": "/(.*\\.html)",   "dest": "/$1" },
    { "src": "/(.*)",          "dest": "/server.js" }
  ]
}
