{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/landing", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/ar", "destination": "/api" },
    { "source": "/magAr", "destination": "/api" },
    { "source": "/createmagzine", "destination": "/createMagzine" },
    { "source": "/createMagazine", "destination": "/createMagzine" },
    { "source": "/createmagazine", "destination": "/createMagzine" },
    { "source": "/magazines", "destination": "/magnizes" },
    { "source": "/magzine", "destination": "/magazine" }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/external/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
