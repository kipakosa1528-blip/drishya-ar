{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets/**",
          "external/**",
          "css/**",
          "js/**",
          "*.html",
          "uploads/.gitkeep"
        ]

      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 8 * * *"
    }
  ]
}
