# Supabase
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...

# Admin login (prefilled at /admin.html; user must exist in Supabase Auth)
ADMIN_EMAIL=admin@kipakosa.app

# Cloudflare R2
R2_ACCOUNT_ID=<cloudflare account id>
R2_ACCESS_KEY_ID=<token id>
R2_SECRET_ACCESS_KEY=<token secret>
R2_BUCKET=kipakosa-videos
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Server
PORT=3000

# Test-only (optional): enables auth-dependent Playwright suites
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# RUN_E2E_REAL=0
